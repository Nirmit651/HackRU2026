{
  "framework": "vite",
  "buildCommand": "npm run db:generate && npm run build:api && npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" }
  ],
  "crons": [
    { "path": "/api/presentation/tick", "schedule": "* * * * *" }
  ]
}
