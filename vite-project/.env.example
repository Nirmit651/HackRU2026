# Copy to .env; never commit real credentials. Run all commands from vite-project.
# Runtime PostgreSQL role. Hosted: use a least-privilege role and TLS verification.
DATABASE_URL=postgresql://hackru@127.0.0.1:55432/hackru
# Separate migration-owner connection; Prisma touches application tables only.
DIRECT_DATABASE_URL=postgresql://hackru@127.0.0.1:55432/hackru
# Public browser-safe configuration; API /config exposes only these values.
SUPABASE_URL=https://uyjnsuazcxwzoxauhmpm.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Server-only Tiger runtime connection. Empty activates honest ledger fallback.
TIGER_DATABASE_URL=
APP_ORIGIN=http://localhost:5173
PORT=3001
# Loopback-only development sign-in; NEVER enabled in production.
LOCAL_DEMO_AUTH=true
# Optional teammate HTTP adapter, credentials sent only from server.
BUS_ADAPTER_URL=
BUS_ADAPTER_TOKEN=
# Optional normalized observation endpoint; never treats an outage as a NO.
EVIDENCE_ADAPTER_URL=
EVIDENCE_ADAPTER_TOKEN=
# MapLibre style URL with permitted tiles and attribution. Empty shows coordinates.
MAP_STYLE_URL=
# Server-only provider credentials.
CFBD_API_KEY=
CBBD_API_KEY=
# NWS requires an identifying User-Agent; include a monitored contact address.
NWS_USER_AGENT=
# Optional JSON settings used by `npm run automation -- enable <env> <type>`.
# Defaults are validated in server/automation/core.ts; LIVE bus needs verified
# stops, sourceSystem and explicit sourceVerifiedLive=true after ingestion review.
AUTOMATION_SETTINGS={}
# Optional authorized external runner; embedded worker requires no HTTP token.
DEMO_WORKER_TOKEN=
DEMO_WORKER_ENVIRONMENT_ID=
# Optional Devnet-only receipt commitments; JSON secret key stays server-side.
SOLANA_ENABLED=false
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_SECRET_KEY=
