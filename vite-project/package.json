{
  "name": "vite-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:api": "esbuild server/api.ts --bundle --platform=node --format=esm --packages=external --outfile=.vercel-api/server.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "api": "tsx server/api.ts",
    "worker": "tsx server/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/math.test.ts tests/recovery.test.ts tests/chain.test.ts tests/providers.test.ts tests/automation.test.ts tests/auth-ui.test.ts tests/presentation.test.ts",
    "test:db": "vitest run tests/engine.test.ts tests/authorization.test.ts tests/automation-db.test.ts",
    "test:local-db": "tsx scripts/test-local-db.ts",
    "test:automation-browser": "tsx scripts/test-local-db.ts --browser",
    "automation": "tsx scripts/automation.ts",
    "automation:demo": "tsx scripts/automation.ts demo",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "demo:new": "tsx scripts/demo.ts",
    "demo:run": "tsx scripts/run-demo.ts",
    "demo:showcase": "tsx scripts/showcase.ts",
    "demo:verify-worker": "tsx scripts/verify-worker.ts",
    "demo:replay": "tsx scripts/demo.ts replay",
    "benchmark": "tsx scripts/benchmark.ts",
    "chain:worker": "tsx scripts/chain-worker.ts",
    "test:outbox": "vitest run tests/outbox.test.ts",
    "tiger:migrate": "tsx scripts/tiger-migrate.ts",
    "tiger:benchmark": "tsx scripts/tiger-benchmark.ts",
    "demo:export": "tsx scripts/export-demo.ts",
    "live:new": "tsx scripts/live.ts",
    "rutgers:setup": "tsx scripts/rutgers.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@solana-program/memo": "0.15.0",
    "@solana/kit": "8.4.0",
    "@solana/kit-plugin-rpc": "0.19.0",
    "@solana/kit-plugin-signer": "0.19.0",
    "@supabase/supabase-js": "2.117.3",
    "decimal.js": "10.6.0",
    "dotenv": "18.0.7",
    "express": "5.3.0",
    "lightweight-charts": "5.2.1",
    "lucide-react": "1.55.0",
    "luxon": "^3.7.2",
    "maplibre-gl": "6.13.0",
    "pg": "8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/express": "5.0.6",
    "@types/luxon": "^3.7.6",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "3.9.10",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "^8.3.0",
    "vitest": "5.0.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.5"
  }
}
